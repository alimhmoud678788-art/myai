{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege permissions for the main and quick windows",
  "windows": ["main", "quick"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "opener:default",
    "deep-link:default",
    "store:default",
    "dialog:default",
    "fs:allow-write-file",
    "updater:default",
    "process:allow-restart"
  ]
}
