{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyAI",
  "version": "0.1.1",
  "identifier": "com.myai.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyAI",
        "width": 1200,
        "height": 800,
        "minWidth": 820,
        "minHeight": 560,
        "center": true
      },
      {
        "label": "quick",
        "title": "MyAI Quick Chat",
        "width": 680,
        "height": 460,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://generativelanguage.googleapis.com; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5MzQ3Q0I3MTVEMzU2QzMKUldURFZ0TVZ0M3cwbWZnM25DT1EweVFVYTBRemdYNGxOQjg0ZFZNak1LWGVPeFZDUm1vRWhzd0YK",
      "endpoints": [
        "https://github.com/alimhmoud678788-art/myai/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "MyAI",
    "shortDescription": "MyAI desktop assistant",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "English",
          "Arabic"
        ],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    }
  }
}
